							58.42530331661075,23.61173008692124,0 58.49620951046381,23.56517399963239,0 58.58901103658406,23.53717564802642,0 58.6758545279215,23.57341258619252,0 58.66686632694976,23.63308637307487,0 58.6256579557938,23.69504277252151,0 58.54130353785651,23.71865320103775,0 58.44726647827417,23.69038570646293,0 58.42530331661075,23.61173008692124,0 
